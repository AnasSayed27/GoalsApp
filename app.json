{
  "expo": {
    "name": "Goals",
    "slug": "NewGoalsApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/OIP.png",
    "scheme": "goalsapp",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uac.Goals",
      "buildNumber": "1",
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/OIP.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uac.Goals",
      "versionCode": 1,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "jsEngine": "hermes"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "48cb1fcd-a1c0-4f25-a781-3cb1ce2de0c7"
      }
    }
  }
}